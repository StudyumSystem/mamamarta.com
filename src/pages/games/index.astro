---
import Layout from '../../layouts/Layout.astro';
import { GAMES } from '../../components/react/games/gamesList.js';
import { TAGLINE } from '../../components/react/games/GameShell.jsx';
---

<Layout title="Games · Mama Marta" description="Short games by Mama Marta, design house for digital products.">
	<main class="min-h-screen bg-white px-5 py-16 font-[Inter] text-black md:py-24">
		<div class="mx-auto max-w-5xl">
			<a href="/" class="text-sm text-black/50 transition-colors hover:text-pink-500">← Mama Marta</a>
			<h1 class="mt-6 text-5xl font-bold tracking-tight md:text-7xl">Games</h1>
			<p class="mt-4 text-lg font-light text-black/60">{TAGLINE}</p>
			<ul class="mt-12 grid gap-6 sm:grid-cols-2">
				{GAMES.map((g) => (
					<li>
						<a href={`/games/${g.slug}`} class="group flex h-56 flex-col justify-between rounded-3xl bg-black p-8 text-white transition-colors duration-300 hover:bg-pink-500">
							<span class="text-sm uppercase tracking-[0.3em] text-white/60">Play</span>
							<span>
								<span class="block text-3xl font-semibold md:text-4xl">{g.title}</span>
								<span class="mt-2 block font-light text-white/70">{g.line}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</main>
</Layout>

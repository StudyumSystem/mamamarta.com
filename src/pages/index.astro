---
import CaseStudiesSection from '../components/react/CaseStudies/index.jsx';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/react/Hero.jsx';
import Library from '../components/react/Library.jsx';
import FoundersChallenge from '../components/react/FoundersChallenge.jsx';
import WhatIsSection from '../components/react/WhatIsSection.jsx';
import PlatformSection from '../components/react/PlatformSection.jsx';
import BrandSection from '../components/react/BrandSection.jsx';
import ContactSection from '../components/react/ContactSection.jsx';
import CollaborateForms from '../components/react/forms/CollaborateForms.jsx';
---

<Layout preload={[
	{ href: '/assets/brand/footer-desktop.webp', media: '(min-width: 768px)' },
	{ href: '/assets/brand/footer-mobile.webp', media: '(max-width: 767px)' },
]}>
	<div id="site-shell" class="bg-white text-black">
		<Hero client:load />
		<!-- Marta's reworked home (her Desktop.jpg, 11 Nov): What is, then the games (Founder's blind spot), then Platform -->
		<WhatIsSection />
		<FoundersChallenge client:load />
		<PlatformSection />
		<ContactSection client:visible />
		<BrandSection client:load/>
	</div>
	<CollaborateForms client:load />

</Layout>

<script>
	// Marta's cable in What is (11 Nov 19:27): it draws itself in when the block comes into view (CSS in
	// global.css, .mm-wire-draw / .mm-wire-sheen). Without this script the cable is simply there.
	document.documentElement.classList.add('mm-js');
	const whatIs = document.getElementById('what-is');
	if (whatIs && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(([e]) => {
			if (e.isIntersecting) {
				whatIs.classList.add('mm-in');
				io.disconnect();
			}
		}, { threshold: 0.3 });
		io.observe(whatIs);
	} else if (whatIs) {
		whatIs.classList.add('mm-in');
	}
</script>


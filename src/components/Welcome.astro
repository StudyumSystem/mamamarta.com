<div id="site-shell" class="min-h-screen bg-white text-black">
  <main class="mx-auto flex min-h-screen max-w-7xl flex-col justify-center xs:px-3 sm:px-8 md:px-10 lg:px-12 xl:px-14 2xl:px-16 xs:py-8 sm:py-12 md:py-14 lg:py-16 2xl:py-20">
    <div class="max-w-3xl space-y-6">
      <p class="text-xs uppercase tracking-[0.34em] text-black/45">Mama Marta</p>
      <h1 class="xs:text-3xl sm:text-5xl md:text-6xl lg:text-8xl xl:text-8xl 2xl:text-9xl font-medium leading-[0.9] tracking-tighter">
        Sections are now separate pages.
      </h1>
      <p class="max-w-2xl xs:text-base sm:text-lg md:text-lg lg:text-lg xl:text-xl 2xl:text-2xl leading-relaxed text-black/65">
        Open each section directly, including the case studies preview and detailed case-study pages.
      </p>
    </div>

    <div class="mt-12 grid xs:gap-3 sm:gap-4 md:gap-4 lg:gap-4 xl:grid-cols-2 2xl:grid-cols-3 2xl:gap-5 xl:gap-4">

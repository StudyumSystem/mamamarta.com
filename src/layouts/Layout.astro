---
// Inter, the site's font (the CSS @import never resolved its files, so text fell back to the system font).
import '@fontsource/inter/100.css';
import '@fontsource/inter/200.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// Her "experience" font (global.css, .mm-exp), served with the site and asked for with the page (14 Nov, Marta:
// "Слово experience скаче і міняє шрифт": fetched from jsDelivr after the page had loaded, it replaced the site's
// italic on screen and moved the word). TODO on commit: move the file into public/fonts and point both here.
import expItalic from '../../../../from-phone/Inter-Italic.woff2?url';

interface Props {
	title?: string;
	description?: string;
	// Heavy pictures to start loading at once (e.g. the footer fur), each for its screen size.
	preload?: { href: string; media?: string }[];
	// The browser bar colour (Safari, Chrome on phones): white on the white game pages, black elsewhere (the dark hero).
	themeColor?: string;
	// The page has her italic "experience" (the home page): its font is fetched with the page, before the first paint.
	italicWord?: boolean;
}
const site = 'https://mamamarta.com';
const {
	title = 'Mamamarta · Design house for digital products',
	description = 'Mamamarta is a design house for digital products, crafted to shape systems, interactions, and digital identity. Book a discovery call.',
	preload = [],
	themeColor = '#000000',
	italicWord = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href="/favicon-white.svg" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mamamarta" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta property="og:image" content={site + "/og.jpg"} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="theme-color" content={themeColor} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: 'Mamamarta',
			url: site,
			description,
			email: 'mymamamarta@icloud.com',
			sameAs: ['https://www.linkedin.com/company/mamamarta/', 'https://www.instagram.com/mymamamarta/'],
		})} />
		{preload.map((p) => <link rel="preload" as="image" href={p.href} media={p.media} fetchpriority="high" />)}
		{italicWord && <link rel="preload" as="font" type="font/woff2" href={expItalic} crossorigin />}
		<ClientRouter />
	</head>
	<body>
		<slot />
		<script>
			import '../scripts/scroll-reveals.js';
			import '../scripts/lazy-videos.js';
			import '../scripts/back-link.js';
		</script>
	</body>
</html>

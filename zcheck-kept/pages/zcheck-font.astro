---
// Check page (not linked): her Figma's own picture of MM-BIO-01 (crops at 1:1) next to the site's text at her numbers.
import fig from '../../../../figma/Pc2G2suH2aQvXj0BuFkYWS-959-105.png?url';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
---
<html>
<head>
<meta charset="utf-8" />
<style>
@font-face { font-family: "I319"; src: url("https://cdn.jsdelivr.net/gh/rsms/inter@v3.19/docs/font-files/Inter-Regular.woff2") format("woff2"); font-weight: 400; }
html { -webkit-font-smoothing: antialiased; }
body { margin: 0; background: #fff; font-family: Inter; }
.row { display: flex; gap: 20px; padding: 6px 10px; }
.crop { background-repeat: no-repeat; flex: none; }
.t { width: 682px; flex: none; }
.h { font-size: 50px; line-height: 59px; letter-spacing: -0.04em; text-align: center; width: 320px; }
.s { font-size: 18px; line-height: 34px; letter-spacing: -0.04em; color: rgba(0,0,0,.69); text-align: center; width: 320px; }
.b { font-size: 22px; line-height: 34px; letter-spacing: -0.04em; color: rgba(0,0,0,.69); margin: 0; }
.c319 { font-family: I319; }
</style>
</head>
<body>
<div class="row">
  <div class="crop" style={`width:320px;height:107px;background-image:url(${fig});background-position:-800px -1220px`}></div>
